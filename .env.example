# Copie para .env e ajuste. NUNCA versione o .env.

# --- domínio e sessão -------------------------------------------------------
DOMINIO=fiap.pervian.tech
AUTH_URL=https://fiap.pervian.tech
# gere com: openssl rand -base64 32
AUTH_SECRET=troque-isto

# --- acesso -----------------------------------------------------------------
# Domínios de e-mail que podem entrar (separados por vírgula)
ALLOWED_EMAIL_DOMAINS=fiap.com.br,alunos.fiap.com.br
# Código que a turma usa para criar conta com senha
CODIGO_TURMA=troque-isto

# --- login com Outlook / Microsoft Entra ID (opcional) ----------------------
# Registre um app em https://entra.microsoft.com > Registros de aplicativo
# Redirect URI: https://fiap.pervian.tech/api/auth/callback/microsoft-entra-id
# Deixe vazio para esconder o botão e usar só e-mail + senha.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# 'common' aceita qualquer tenant (o filtro de domínio continua valendo);
# troque pelo id do tenant da FIAP se registrar o app lá dentro.
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# --- banco ------------------------------------------------------------------
POSTGRES_PASSWORD=troque-isto

# --- conteúdo ---------------------------------------------------------------
REPO_CONTEUDO=https://github.com/mariacmartins/computational_thinking_with_python
# de quanto em quanto tempo procurar aulas novas (segundos)
INTERVALO_SYNC=1800
