# Copie para .env e ajuste. NUNCA versione o .env.

# --- sessão -----------------------------------------------------------------
# URL pública (na VPS: https://seu.dominio)
AUTH_URL=http://localhost:8082
# gere com: openssl rand -base64 32
AUTH_SECRET=troque-isto

# --- acesso -----------------------------------------------------------------
# Domínios de e-mail que podem entrar (separados por vírgula)
ALLOWED_EMAIL_DOMAINS=fiap.com.br,alunos.fiap.com.br
# Código que a turma usa para criar conta com senha
CODIGO_TURMA=troque-isto

# --- banco ------------------------------------------------------------------
POSTGRES_PASSWORD=troque-isto

# --- conteúdo ---------------------------------------------------------------
# de quanto em quanto tempo o sync procura aulas novas (segundos).
# Os repos das disciplinas ficam fixos em docker/sync.sh e no Dockerfile.
INTERVALO_SYNC=1800

# --- interno ----------------------------------------------------------------
# segredo do /api/interno/broadcast (sync avisa o app de aula nova).
# vazio = endpoint desligado. gere com: openssl rand -hex 24
INTERNO_SECRET=troque-isto
