<resources>
    <style name="Theme.FiapEstudante" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/fiap</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash: fundo magenta com o logo FIAP branco no centro. -->
    <style name="Theme.FiapEstudante.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fiap</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FiapEstudante</item>
    </style>
</resources>
